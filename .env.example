# Optional public listing overrides; values are visible in the website bundle.
# Leave rating values blank to use the supplied screenshot values (3.9 / 42).
NEXT_PUBLIC_LOTUS_RATING_VALUE=
NEXT_PUBLIC_LOTUS_REVIEW_COUNT=
NEXT_PUBLIC_LOTUS_RATING_VISIBLE=true

# Member authentication and database (public key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Server-only; never use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Contact form delivery (server-only; add the Formspree form ID after creating a form).
FORMSPREE_FORM_ID=
